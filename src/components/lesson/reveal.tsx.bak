"use client";

import { ReactNode } from "react";
import { motion, AnimatePresence, useReducedMotion } from "motion/react";
import { useNarrationStore, selectNarrationFraction } from "@/store/narration";

const EASE_OUT_QUART: [number, number, number, number] = [0.16, 1, 0.3, 1];

export interface RevealProps {
  /** Phase threshold in 0..1. Element appears when audio fraction reaches this value. */
  atFraction: number;
  children: ReactNode;
  /** Optional y-translation distance in pixels. Default 8. */
  rise?: number;
  /** Optional fade-in duration in seconds. Default 0.32. */
  duration?: number;
  /** Optional className for the wrapping motion.div. */
  className?: string;
}

/**
 * Renders children only after the current narration track's playback fraction
 * has reached `atFraction`. Use this to make on-screen elements appear in
 * sync with the narration — e.g. a per-version callout that fades in just as
 * the narrator says "and the model self-reports it passes all three checks."
 *
 * Reads fraction via the narration store (no per-slide wiring required). When
 * the track is not loaded yet (durationMs === 0) the element stays hidden,
 * which is the right default: if there's no audio, nothing should reveal.
 *
 * Reduced-motion path: renders children immediately, no animation.
 */
export function Reveal({
  atFraction,
  children,
  rise = 8,
  duration = 0.32,
  className,
}: RevealProps) {
  const reduce = useReducedMotion();
  const fraction = useNarrationStore(selectNarrationFraction);
  const visible = fraction + 1e-6 >= atFraction;

  if (reduce) {
    return <div className={className}>{visible ? children : null}</div>;
  }

  return (
    <AnimatePresence>
      {visible && (
        <motion.div
          key="reveal"
          initial={{ opacity: 0, transform: `translateY(${rise}px)` }}
          animate={{ opacity: 1, transform: "translateY(0)" }}
          exit={{ opacity: 0, transform: `translateY(-${rise}px)` }}
          transition={{ duration, ease: EASE_OUT_QUART }}
          className={className}
        >
          {children}
        </motion.div>
      )}
    </AnimatePresence>
  );
}
